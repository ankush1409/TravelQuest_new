# ==============================================
# AWS AMPLIFY ENVIRONMENT CONFIGURATION
# ==============================================
# Copy this file to .env and fill in your AWS values
# Run 'amplify init' and 'amplify push' to generate these values

# AWS Region (e.g., us-east-1, us-west-2, eu-west-1)
VITE_AWS_REGION=us-east-1

# AWS Cognito User Pool Configuration
VITE_AWS_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_AWS_USER_POOL_WEB_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_AWS_IDENTITY_POOL_ID=us-east-1:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# AWS Cognito OAuth Domain (for Google Sign-In)
VITE_AWS_COGNITO_DOMAIN=travelquest-auth.auth.us-east-1.amazoncognito.com

# OAuth Redirect URLs
VITE_AWS_OAUTH_REDIRECT_SIGN_IN=https://localhost:3000/
VITE_AWS_OAUTH_REDIRECT_SIGN_OUT=https://localhost:3000/

# AWS AppSync GraphQL API
VITE_AWS_APPSYNC_GRAPHQL_ENDPOINT=https://xxxxxxxxxxxxxxxxxxxxxxxxxx.appsync-api.us-east-1.amazonaws.com/graphql
VITE_AWS_APPSYNC_API_KEY=da2-xxxxxxxxxxxxxxxxxxxxxxxxxx

# AWS S3 Storage Bucket
VITE_AWS_S3_BUCKET=travelquest-storage-xxxxxx

# AWS Pinpoint (Analytics - Optional)
VITE_AWS_PINPOINT_APP_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ==============================================
# EXTERNAL API KEYS
# ==============================================

# Google Places API Key (for location services)
GOOGLE_PLACES_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Google OAuth 2.0 Credentials (for server-side auth)
GOOGLE_CLIENT_ID=xxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ==============================================
# DEVELOPMENT CONFIGURATION
# ==============================================

# Node Environment
NODE_ENV=development

# JWT Secret for session management (generate a strong random string)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Database URL (if using PostgreSQL for development)
DATABASE_URL=postgresql://username:password@localhost:5432/travelquest

# Development domain (for OAuth callbacks)
REPLIT_DEV_DOMAIN=localhost:3000

# ==============================================
# PRODUCTION CONFIGURATION NOTES
# ==============================================
# 
# For production deployment:
# 1. Set NODE_ENV=production
# 2. Use strong, unique JWT_SECRET
# 3. Configure OAuth redirect URLs for your domain
# 4. Set up proper CORS policies in AWS
# 5. Enable CloudWatch logging for Lambda functions
# 6. Configure proper IAM roles and permissions
# 7. Set up AWS WAF for API protection
# 8. Enable AWS CloudTrail for audit logging
#