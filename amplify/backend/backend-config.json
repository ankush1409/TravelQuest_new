{
  "api": {
    "travelquest": {
      "service": "AppSync",
      "providerPlugin": "awscloudformation",
      "dependsOn": [
        {
          "category": "auth",
          "resourceName": "travelquest",
          "attributes": ["UserPoolId"]
        }
      ],
      "output": {
        "authConfig": {
          "defaultAuthentication": {
            "authenticationType": "AMAZON_COGNITO_USER_POOLS"
          },
          "additionalAuthenticationProviders": [
            {
              "authenticationType": "API_KEY",
              "apiKeyConfig": {
                "apiKeyExpirationDays": 365,
                "description": "TravelQuest API Key"
              }
            }
          ]
        }
      }
    }
  },
  "auth": {
    "travelquest": {
      "service": "Cognito",
      "providerPlugin": "awscloudformation",
      "dependsOn": [],
      "customAuth": false,
      "frontendAuthConfig": {
        "socialProviders": ["GOOGLE"],
        "usernameAttributes": ["EMAIL"],
        "signupAttributes": ["EMAIL"],
        "passwordProtectionSettings": {
          "passwordPolicyMinLength": 8,
          "passwordPolicyCharacters": []
        },
        "mfaConfiguration": "OFF",
        "mfaTypes": ["SMS"],
        "verificationMechanisms": ["EMAIL"]
      }
    }
  },
  "function": {
    "travelquestResolver": {
      "service": "Lambda",
      "providerPlugin": "awscloudformation",
      "build": true,
      "dependsOn": [
        {
          "category": "auth",
          "resourceName": "travelquest",
          "attributes": ["UserPoolId"]
        }
      ]
    },
    "travelquestStreakProcessor": {
      "service": "Lambda",
      "providerPlugin": "awscloudformation",
      "build": true
    },
    "travelquestPlacesService": {
      "service": "Lambda",
      "providerPlugin": "awscloudformation",
      "build": true
    }
  },
  "storage": {
    "travelquestdb": {
      "service": "DynamoDB",
      "providerPlugin": "awscloudformation"
    },
    "travelquestassets": {
      "service": "S3",
      "providerPlugin": "awscloudformation"
    }
  },
  "hosting": {
    "amplifyhosting": {
      "service": "amplifyhosting",
      "type": "manual"
    }
  }
}